// Alicerce - Schema do Banco de Dados em Português (Prisma ORM para MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS (PORTUGUÊS)
// ------------------------------------------------------

enum TipoWorkspace {
  PESSOAL
  FAMILIAR
  EMPRESARIAL
}

enum PapelWorkspace {
  PROPRIETARIO
  ADMINISTRADOR
  MEMBRO
  VISUALIZADOR
}

enum TipoSalario {
  FIXO
  POR_HORA
  COMISSAO
  DIARIO
  PERSONALIZADO
}

enum TipoAjusteSalario {
  HORA_EXTRA
  FERIAS
  DECIMO_TERCEIRO
  PLR
  BONUS
  DESCONTO
  OUTRO
}

enum TipoCarteira {
  CONTA_CORRENTE
  DINHEIRO
  CARTEIRA_DIGITAL
  POUPANCA
  INVESTIMENTO
  CARTAO_CREDITO
}

enum TipoMovimentacao {
  SALDO_INICIAL
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SAIDA
  RECEITA
  DESPESA
  AJUSTE
  ESTORNO
  INVESTIMENTO
  RESGATE
}

enum StatusDocumento {
  ATIVO
  CANCELADO
}

enum StatusLiquidacao {
  PENDENTE
  LIQUIDADO
}

enum OrigemMovimentacao {
  MANUAL
  IMPORTACAO_OFX
  API
  RECORRENCIA
  SISTEMA
}

enum ReferenciaTipoMovimentacao {
  RECEITA
  DESPESA
  TRANSFERENCIA
  AJUSTE
  SALDO_INICIAL
  ESTORNO
}

enum BandeiraCartao {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OUTRA
}

enum StatusFatura {
  ABERTA
  FECHADA
  PAGA
  ATRASADA
}

enum StatusRecorrencia {
  ATIVA
  PAUSADA
  CANCELADA
}

enum TipoRecorrencia {
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
  PERSONALIZADA
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusDespesa {
  PENDENTE
  PAGA
  ATRASADA
  CANCELADA
}

enum StatusReceita {
  PENDENTE
  RECEBIDA
  CANCELADA
}

enum TipoCategoria {
  RECEITA
  DESPESA
  AMBAS
}

enum StatusMeta {
  ATIVA
  CONCLUIDA
  PAUSADA
  CANCELADA
}

enum PrioridadeWishlist {
  ALTA
  MEDIA
  BAIXA
}

enum StatusWishlist {
  ANALISE
  PLANEJADO
  COMPRADO
  DESISTIDO
}

enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusItemProjeto {
  PENDENTE
  COTADO
  COMPRADO
  INSTALADO
  CANCELADO
}

enum StatusParcelamento {
  ATIVO
  CONCLUIDO
  CANCELADO
}

enum StatusParcela {
  PENDENTE
  FATURADA
  PAGA
  ATRASADA
  CANCELADA
}

enum TipoAlerta {
  CONTA_VENCENDO
  META_ATINGIDA
  ORCAMENTO_EXCEDIDO
  SALARIO_RECEBIDO
  QUEDA_PRECO
  SISTEMA
}

enum TipoFeriado {
  NACIONAL
  ESTADUAL
  FACULTATIVO
}

enum TemaInterface {
  CLARO
  ESCURO
  SISTEMA
}

// ------------------------------------------------------
// AUTENTICAÇÃO E WORKSPACE
// ------------------------------------------------------

model Usuario {
  id              String   @id @default(uuid())
  email           String   @unique
  senhaHash       String   @map("senha_hash")
  nome            String
  avatarUrl       String?  @map("avatar_url")
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  tokensAtualizacao    TokenAtualizacao[]
  workspaces           MembroWorkspace[]
  configuracao         ConfigUsuario?
  alertas              Alerta[]
  configAlertas        ConfigAlerta[]
  movimentacoesCriadas MovimentacaoFinanceira[]

  @@map("usuarios")
}

model TokenAtualizacao {
  id            String   @id @default(uuid())
  usuarioId     String   @map("usuario_id")
  token         String   @unique
  dataExpiracao DateTime @map("data_expiracao")
  dataCriacao   DateTime @default(now()) @map("data_criacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_atualizacao")
}

model Workspace {
  id              String        @id @default(uuid())
  nome            String
  proprietarioId  String        @map("proprietario_id")
  tipo            TipoWorkspace @default(PESSOAL)
  dataCriacao     DateTime      @default(now()) @map("data_criacao")
  dataAtualizacao DateTime      @updatedAt @map("data_atualizacao")

  membros                  MembroWorkspace[]
  pessoas                  Pessoa[]
  carteiras                Carteira[]
  cartoesCredito           CartaoCredito[]
  categorias               Categoria[]
  receitas                 Receita[]
  despesas                 Despesa[]
  metas                    Meta[]
  produtos                 Produto[]
  lojas                    Loja[]
  itensWishlist            ItemWishlist[]
  cotacoesAvulsas          CotacaoAvulsa[]
  projetos                 Projeto[]
  etapasProjeto            EtapaProjeto[]
  itensProjeto             ItemProjeto[]
  orcamentos               Orcamento[]
  projecoes                Projecao[]
  transacoes               Transacao[]
  parcelamentos            Parcelamento[]
  configMeses              ConfigMes[]
  movimentacoesFinanceiras MovimentacaoFinanceira[]
  transferenciasCarteira   TransferenciaCarteira[]
  regrasRecorrencia        RegraRecorrencia[]
  alertas                  Alerta[]

  @@map("workspaces")
}

model MembroWorkspace {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  usuarioId   String         @map("usuario_id")
  papel       PapelWorkspace @default(MEMBRO)
  dataEntrada DateTime       @default(now()) @map("data_entrada")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, usuarioId])
  @@map("membros_workspace")
}

model ConfigUsuario {
  id                 String        @id @default(uuid())
  usuarioId          String        @unique @map("usuario_id")
  tema               TemaInterface @default(CLARO)
  moeda              String        @default("BRL")
  estado             String?
  cidade             String?
  idioma             String        @default("pt-BR")
  notificacoesAtivas Boolean       @default(true) @map("notificacoes_ativas")
  dataAtualizacao    DateTime      @updatedAt @map("data_atualizacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("config_usuario")
}

// ------------------------------------------------------
// PESSOAS E SALÁRIOS
// ------------------------------------------------------

model Pessoa {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  nome            String
  parentesco      String
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configSalario   ConfigSalario?
  salariosMensais SalarioMensal[]
  receitas        Receita[]
  carteiras       Carteira[]

  @@index([workspaceId])
  @@map("pessoas")
}

model ConfigSalario {
  id              String      @id @default(uuid())
  pessoaId        String      @unique @map("pessoa_id")
  tipo            TipoSalario
  valorBase       Decimal?    @map("valor_base") @db.Decimal(12, 2)
  valorHora       Decimal?    @map("valor_hora") @db.Decimal(10, 2)
  horasDiarias    Decimal?    @map("horas_diarias") @db.Decimal(4, 2)
  diasTrabalho    Json?       @map("dias_trabalho")
  ativo           Boolean     @default(true)
  dataCriacao     DateTime    @default(now()) @map("data_criacao")
  dataAtualizacao DateTime    @updatedAt @map("data_atualizacao")

  pessoa  Pessoa          @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  ajustes AjusteSalario[]

  @@map("config_salario")
}

model AjusteSalario {
  id              String            @id @default(uuid())
  configSalarioId String            @map("config_salario_id")
  mes             Int
  ano             Int
  tipo            TipoAjusteSalario
  descricao       String?
  valor           Decimal           @db.Decimal(12, 2)
  dataCriacao     DateTime          @default(now()) @map("data_criacao")

  configSalario ConfigSalario @relation(fields: [configSalarioId], references: [id], onDelete: Cascade)

  @@map("ajustes_salario")
}

model SalarioMensal {
  id              String        @id @default(uuid())
  pessoaId        String        @map("pessoa_id")
  mes             Int
  ano             Int
  qtdDiasUteis    Int           @map("qtd_dias_uteis")
  valorPrevisto   Decimal       @map("valor_previsto") @db.Decimal(12, 2)
  valorReal       Decimal?      @map("valor_real") @db.Decimal(12, 2)
  status          StatusReceita @default(PENDENTE)
  dataCriacao     DateTime      @default(now()) @map("data_criacao")
  dataAtualizacao DateTime      @updatedAt @map("data_atualizacao")

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, mes, ano])
  @@map("salarios_mensais")
}

// ------------------------------------------------------
// CARTEIRAS E CARTÕES DE CRÉDITO
// ------------------------------------------------------

model Carteira {
  id                   String       @id @default(uuid())
  workspaceId          String       @map("workspace_id")
  pessoaId             String?      @map("pessoa_id")
  nome                 String
  tipo                 TipoCarteira @default(CONTA_CORRENTE)
  saldo                Decimal      @default(0) @db.Decimal(12, 2)
  permiteSaldoNegativo Boolean      @default(true) @map("permite_saldo_negativo")
  icone                String?
  cor                  String?
  ativo                Boolean      @default(true)
  padrao               Boolean      @default(false)
  dataCriacao          DateTime     @default(now()) @map("data_criacao")
  dataAtualizacao      DateTime     @updatedAt @map("data_atualizacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pessoa    Pessoa?   @relation(fields: [pessoaId], references: [id])

  transferenciasOrigem     TransferenciaCarteira[]  @relation("OrigemTransferencia")
  transferenciasDestino    TransferenciaCarteira[]  @relation("DestinoTransferencia")
  movimentacoesFinanceiras MovimentacaoFinanceira[]
  transacoes               Transacao[]
  receitas                 Receita[]
  despesas                 Despesa[]
  faturasCartao            FaturaCartao[]
  parcelamentos            Parcelamento[]
  regrasRecorrencia        RegraRecorrencia[]

  @@index([workspaceId])
  @@map("carteiras")
}

model MovimentacaoFinanceira {
  id              String                     @id @default(uuid())
  workspaceId     String                     @map("workspace_id")
  carteiraId      String                     @map("carteira_id")
  criadoPorId     String?                    @map("criado_por_id")
  tipo            TipoMovimentacao
  valor           Decimal                    @db.Decimal(12, 2)
  descricao       String?
  data            DateTime                   @default(now())
  transferenciaId String?                    @map("transferencia_id")
  referenciaId    String?                    @map("referencia_id")
  referenciaTipo  ReferenciaTipoMovimentacao @default(RECEITA) @map("referencia_tipo")
  origem          OrigemMovimentacao         @default(MANUAL)
  dataCriacao     DateTime                   @default(now()) @map("data_criacao")
  dataAtualizacao DateTime                   @updatedAt @map("data_atualizacao")

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  carteira      Carteira               @relation(fields: [carteiraId], references: [id], onDelete: Cascade)
  criadoPor     Usuario?               @relation(fields: [criadoPorId], references: [id])
  transferencia TransferenciaCarteira? @relation(fields: [transferenciaId], references: [id])

  @@index([workspaceId])
  @@index([carteiraId])
  @@index([data])
  @@index([transferenciaId])
  @@map("movimentacoes_financeiras")
}

model TransferenciaCarteira {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  carteiraOrigemId  String   @map("carteira_origem_id")
  carteiraDestinoId String   @map("carteira_destino_id")
  valor             Decimal  @db.Decimal(12, 2)
  data              DateTime
  descricao         String?
  dataCriacao       DateTime @default(now()) @map("data_criacao")

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  carteiraOrigem  Carteira                 @relation("OrigemTransferencia", fields: [carteiraOrigemId], references: [id], onDelete: Cascade)
  carteiraDestino Carteira                 @relation("DestinoTransferencia", fields: [carteiraDestinoId], references: [id], onDelete: Cascade)
  movimentacoes   MovimentacaoFinanceira[]

  @@index([workspaceId])
  @@map("transferencias_carteira")
}

model CartaoCredito {
  id              String         @id @default(uuid())
  workspaceId     String         @map("workspace_id")
  nome            String
  bandeira        BandeiraCartao @default(MASTERCARD)
  ultimosDigitos  String?        @map("ultimos_digitos") @db.VarChar(4)
  limiteTotal     Decimal        @map("limite_total") @db.Decimal(12, 2)
  diaFechamento   Int            @map("dia_fechamento")
  diaVencimento   Int            @map("dia_vencimento")
  cor             String?
  icone           String?
  ativo           Boolean        @default(true)
  dataCriacao     DateTime       @default(now()) @map("data_criacao")
  dataAtualizacao DateTime       @updatedAt @map("data_atualizacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  faturas       FaturaCartao[]
  compras       CompraCartao[]
  despesas      Despesa[]
  parcelamentos Parcelamento[]

  @@index([workspaceId])
  @@map("cartoes_credito")
}

model FaturaCartao {
  id             String       @id @default(uuid())
  cartaoId       String       @map("cartao_id")
  mes            Int
  ano            Int
  dataVencimento DateTime     @map("data_vencimento")
  status         StatusFatura @default(ABERTA)
  valorPago      Decimal?     @map("valor_pago") @db.Decimal(12, 2)
  dataPagamento  DateTime?    @map("data_pagamento")
  carteiraId     String?      @map("carteira_id")

  cartao   CartaoCredito   @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  carteira Carteira?       @relation(fields: [carteiraId], references: [id])
  parcelas ParcelaCartao[]

  @@unique([cartaoId, mes, ano])
  @@map("faturas_cartao")
}

model CompraCartao {
  id          String   @id @default(uuid())
  cartaoId    String   @map("cartao_id")
  categoriaId String   @map("categoria_id")
  descricao   String
  valorTotal  Decimal  @map("valor_total") @db.Decimal(12, 2)
  qtdParcelas Int      @default(1) @map("qtd_parcelas")
  dataCompra  DateTime @map("data_compra")
  observacoes String?
  dataCriacao DateTime @default(now()) @map("data_criacao")

  cartao    CartaoCredito   @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  categoria Categoria       @relation(fields: [categoriaId], references: [id])
  parcelas  ParcelaCartao[]

  @@map("compras_cartao")
}

model ParcelaCartao {
  id             String        @id @default(uuid())
  compraId       String        @map("compra_id")
  faturaId       String?       @map("fatura_id")
  numero         Int
  valor          Decimal       @db.Decimal(12, 2)
  competenciaAno Int           @map("competencia_ano")
  competenciaMes Int           @map("competencia_mes")
  status         StatusParcela @default(PENDENTE)

  compra CompraCartao  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  fatura FaturaCartao? @relation(fields: [faturaId], references: [id])

  @@map("parcelas_cartao")
}

model RegraRecorrencia {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  tipo            TipoTransacao
  descricao       String
  valor           Decimal           @db.Decimal(12, 2)
  diaVencimento   Int               @map("dia_vencimento")
  categoriaId     String            @map("categoria_id")
  carteiraId      String?           @map("carteira_id")
  status          StatusRecorrencia @default(ATIVA)
  dataInicio      DateTime          @map("data_inicio")
  dataFim         DateTime?         @map("data_fim")
  dataCriacao     DateTime          @default(now()) @map("data_criacao")
  dataAtualizacao DateTime          @updatedAt @map("data_atualizacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  carteira  Carteira? @relation(fields: [carteiraId], references: [id])

  execucoes ExecucaoRecorrencia[]

  @@map("regras_recorrencia")
}

model ExecucaoRecorrencia {
  id                 String @id @default(uuid())
  regraRecorrenciaId String @map("regra_recorrencia_id")
  competenciaAno     Int    @map("competencia_ano")
  competenciaMes     Int    @map("competencia_mes")
  referenciaId       String @map("referencia_id")

  regra RegraRecorrencia @relation(fields: [regraRecorrenciaId], references: [id], onDelete: Cascade)

  @@unique([regraRecorrenciaId, competenciaAno, competenciaMes])
  @@map("execucoes_recorrencia")
}

model Parcelamento {
  id              String             @id @default(uuid())
  workspaceId     String             @map("workspace_id")
  cartaoId        String?            @map("cartao_id")
  carteiraId      String?            @map("carteira_id")
  categoriaId     String?            @map("categoria_id")
  descricao       String
  valorTotal      Decimal            @map("valor_total") @db.Decimal(12, 2)
  qtdParcelas     Int                @map("qtd_parcelas")
  valorParcela    Decimal            @map("valor_parcela") @db.Decimal(12, 2)
  dataInicio      DateTime           @map("data_inicio")
  dataFim         DateTime?          @map("data_fim")
  status          StatusParcelamento @default(ATIVO)
  dataCriacao     DateTime           @default(now()) @map("data_criacao")
  dataAtualizacao DateTime           @updatedAt @map("data_atualizacao")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cartao    CartaoCredito? @relation(fields: [cartaoId], references: [id])
  carteira  Carteira?      @relation(fields: [carteiraId], references: [id])
  categoria Categoria?     @relation(fields: [categoriaId], references: [id])

  parcelas Parcela[]
  despesas Despesa[]

  @@index([workspaceId])
  @@map("parcelamentos")
}

model Parcela {
  id             String        @id @default(uuid())
  parcelamentoId String        @map("parcelamento_id")
  numero         Int
  valor          Decimal       @db.Decimal(12, 2)
  dataVencimento DateTime      @map("data_vencimento")
  status         StatusParcela @default(PENDENTE)
  dataPagamento  DateTime?     @map("data_pagamento")

  parcelamento Parcelamento @relation(fields: [parcelamentoId], references: [id], onDelete: Cascade)

  @@map("parcelas")
}

// ------------------------------------------------------
// CATEGORIAS E TRANSAÇÕES
// ------------------------------------------------------

model Categoria {
  id              String        @id @default(uuid())
  workspaceId     String?       @map("workspace_id")
  nome            String
  tipo            TipoCategoria @default(AMBAS)
  icone           String?
  cor             String?
  sistema         Boolean       @default(false)
  categoriaPaiId  String?       @map("categoria_pai_id")
  dataCriacao     DateTime      @default(now()) @map("data_criacao")
  dataAtualizacao DateTime      @updatedAt @map("data_atualizacao")

  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoriaPai      Categoria?         @relation("Subcategorias", fields: [categoriaPaiId], references: [id])
  subcategorias     Categoria[]        @relation("Subcategorias")
  receitas          Receita[]
  despesas          Despesa[]
  transacoes        Transacao[]
  produtos          Produto[]
  comprasCartao     CompraCartao[]
  parcelamentos     Parcelamento[]
  orcamentos        Orcamento[]
  regrasRecorrencia RegraRecorrencia[]

  @@map("categorias")
}

model Receita {
  id                  String           @id @default(uuid())
  workspaceId         String           @map("workspace_id")
  pessoaId            String?          @map("pessoa_id")
  carteiraId          String?          @map("carteira_id")
  categoriaId         String           @map("categoria_id")
  descricao           String
  valor               Decimal          @db.Decimal(12, 2)
  data                DateTime
  statusDocumento     StatusDocumento  @default(ATIVO) @map("status_documento")
  statusLiquidacao    StatusLiquidacao @default(PENDENTE) @map("status_liquidacao")
  dataLiquidacao      DateTime?        @map("data_liquidacao")
  origemRecorrenciaId String?          @map("origem_recorrencia_id")
  recorrente          Boolean          @default(false)
  tipoRecorrencia     TipoRecorrencia? @map("tipo_recorrencia")
  configRecorrencia   Json?            @map("config_recorrencia")
  status              StatusReceita    @default(PENDENTE)
  observacoes         String?
  dataCriacao         DateTime         @default(now()) @map("data_criacao")
  dataAtualizacao     DateTime         @updatedAt @map("data_atualizacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pessoa    Pessoa?   @relation(fields: [pessoaId], references: [id])
  carteira  Carteira? @relation(fields: [carteiraId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@index([workspaceId, data])
  @@map("receitas")
}

model Despesa {
  id                  String           @id @default(uuid())
  workspaceId         String           @map("workspace_id")
  carteiraId          String?          @map("carteira_id")
  cartaoId            String?          @map("cartao_id")
  categoriaId         String           @map("categoria_id")
  metaId              String?          @map("meta_id")
  parcelamentoId      String?          @map("parcelamento_id")
  descricao           String
  valor               Decimal          @db.Decimal(12, 2)
  dataVencimento      DateTime         @map("data_vencimento")
  dataPagamento       DateTime?        @map("data_pagamento")
  statusDocumento     StatusDocumento  @default(ATIVO) @map("status_documento")
  statusLiquidacao    StatusLiquidacao @default(PENDENTE) @map("status_liquidacao")
  dataLiquidacao      DateTime?        @map("data_liquidacao")
  origemRecorrenciaId String?          @map("origem_recorrencia_id")
  origemWishlistId    String?          @unique @map("origem_wishlist_id")
  recorrente          Boolean          @default(false)
  tipoRecorrencia     TipoRecorrencia? @map("tipo_recorrencia")
  configRecorrencia   Json?            @map("config_recorrencia")
  status              StatusDespesa    @default(PENDENTE)
  observacoes         String?
  dataExclusao        DateTime?        @map("data_exclusao")
  dataCriacao         DateTime         @default(now()) @map("data_criacao")
  dataAtualizacao     DateTime         @updatedAt @map("data_atualizacao")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  carteira     Carteira?      @relation(fields: [carteiraId], references: [id])
  cartao       CartaoCredito? @relation(fields: [cartaoId], references: [id])
  categoria    Categoria      @relation(fields: [categoriaId], references: [id])
  meta         Meta?          @relation(fields: [metaId], references: [id])
  parcelamento Parcelamento?  @relation(fields: [parcelamentoId], references: [id])

  @@index([workspaceId, dataVencimento])
  @@map("despesas")
}

model Transacao {
  id              String        @id @default(uuid())
  workspaceId     String        @map("workspace_id")
  carteiraId      String?       @map("carteira_id")
  categoriaId     String?       @map("categoria_id")
  metaId          String?       @map("meta_id")
  tipo            TipoTransacao
  descricao       String
  valor           Decimal       @db.Decimal(12, 2)
  data            DateTime
  observacoes     String?
  dataExclusao    DateTime?     @map("data_exclusao")
  dataCriacao     DateTime      @default(now()) @map("data_criacao")
  dataAtualizacao DateTime      @updatedAt @map("data_atualizacao")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  carteira  Carteira?  @relation(fields: [carteiraId], references: [id])
  categoria Categoria? @relation(fields: [categoriaId], references: [id])
  meta      Meta?      @relation(fields: [metaId], references: [id])

  @@index([workspaceId, data])
  @@map("transacoes")
}

// ------------------------------------------------------
// METAS, WISHLIST, PRODUTOS E PROJETOS
// ------------------------------------------------------

model Meta {
  id              String     @id @default(uuid())
  workspaceId     String     @map("workspace_id")
  nome            String
  descricao       String?
  valorAlvo       Decimal    @map("valor_alvo") @db.Decimal(12, 2)
  prazo           DateTime?
  icone           String?
  cor             String?
  status          StatusMeta @default(ATIVA)
  prioridade      Int        @default(1)
  dataExclusao    DateTime?  @map("data_exclusao")
  dataCriacao     DateTime   @default(now()) @map("data_criacao")
  dataAtualizacao DateTime   @updatedAt @map("data_atualizacao")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aportes      AporteMeta[]
  despesas     Despesa[]
  transacoes   Transacao[]
  itensProjeto ItemProjeto[]

  @@index([workspaceId, status])
  @@map("metas")
}

model AporteMeta {
  id          String        @id @default(uuid())
  metaId      String        @map("meta_id")
  valor       Decimal       @db.Decimal(12, 2)
  data        DateTime
  descricao   String?
  tipo        TipoTransacao @default(RECEITA)
  dataCriacao DateTime      @default(now()) @map("data_criacao")

  meta Meta @relation(fields: [metaId], references: [id], onDelete: Restrict)

  @@map("aportes_meta")
}

model Loja {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  nome        String
  urlWebsite  String?  @map("url_website")
  urlLogo     String?  @map("url_logo")
  sistema     Boolean  @default(false)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  linksProduto LinkProduto[]
  cotacoes     Cotacao[]

  @@index([workspaceId, ativo])
  @@map("lojas")
}

model Produto {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  nome            String
  descricao       String?
  marca           String?
  categoriaId     String?  @map("categoria_id")
  observacoes     String?
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  categoria     Categoria?      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  imagens       ImagemProduto[]
  links         LinkProduto[]
  itensWishlist ItemWishlist[]

  @@index([workspaceId, ativo])
  @@map("produtos")
}

model ImagemProduto {
  id          String   @id @default(uuid())
  produtoId   String   @map("produto_id")
  url         String   @db.Text
  ordem       Int      @default(0)
  principal   Boolean  @default(false)
  ativo       Boolean  @default(true)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([produtoId, ordem])
  @@map("imagens_produto")
}

model LinkProduto {
  id                String    @id @default(uuid())
  produtoId         String    @map("produto_id")
  lojaId            String    @map("loja_id")
  url               String    @db.Text
  preco             Decimal   @db.Decimal(10, 2)
  versao            Int       @default(0)
  ativo             Boolean   @default(true)
  ultimaVerificacao DateTime? @map("ultima_verificacao")
  dataCriacao       DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao   DateTime  @updatedAt @map("data_atualizacao")

  produto         Produto          @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  loja            Loja             @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  historicoPrecos HistoricoPreco[]

  @@unique([produtoId, lojaId])
  @@map("links_produto")
}

model HistoricoPreco {
  id            String   @id @default(uuid())
  linkProdutoId String   @map("link_produto_id")
  preco         Decimal  @db.Decimal(10, 2)
  data          DateTime @default(now())

  linkProduto LinkProduto @relation(fields: [linkProdutoId], references: [id], onDelete: Restrict)

  @@index([linkProdutoId, data])
  @@map("historico_precos")
}

model ItemWishlist {
  id                    String             @id @default(uuid())
  workspaceId           String             @map("workspace_id")
  produtoId             String?            @map("produto_id")
  nome                  String
  descricao             String?
  linkUrl               String?            @map("link_url") @db.Text
  imagemUrl             String?            @map("imagem_url") @db.Text
  precoAlvo             Decimal?           @map("preco_alvo") @db.Decimal(10, 2)
  valorCompra           Decimal?           @map("valor_compra") @db.Decimal(10, 2)
  valorEconomizado      Decimal?           @map("valor_economizado") @db.Decimal(10, 2)
  prioridade            PrioridadeWishlist @default(MEDIA)
  diasEsfriamento       Int                @default(7) @map("dias_esfriamento")
  inicioEsfriamento     DateTime           @default(now()) @map("inicio_esfriamento")
  fimEsfriamento        DateTime           @map("fim_esfriamento")
  status                StatusWishlist     @default(ANALISE)
  quebrouEsfriamento    Boolean            @default(false) @map("quebrou_esfriamento")
  dataQuebraEsfriamento DateTime?          @map("data_quebra_esfriamento")
  dataConclusao         DateTime?          @map("data_conclusao")
  versao                Int                @default(0)
  ativo                 Boolean            @default(true)
  dataCriacao           DateTime           @default(now()) @map("data_criacao")
  dataAtualizacao       DateTime           @updatedAt @map("data_atualizacao")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  produto         Produto?        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  cotacoes        Cotacao[]
  cotacoesAvulsas CotacaoAvulsa[]
  itensProjeto    ItemProjeto[]

  @@index([workspaceId, status, ativo])
  @@map("itens_wishlist")
}

model CotacaoAvulsa {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  itemWishlistId  String   @map("item_wishlist_id")
  nomeLoja        String   @map("nome_loja")
  preco           Decimal  @db.Decimal(10, 2)
  url             String?  @db.Text
  observacoes     String?  @db.Text
  versao          Int      @default(0)
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  itemWishlist ItemWishlist @relation(fields: [itemWishlistId], references: [id], onDelete: Restrict)

  @@index([workspaceId, itemWishlistId, ativo])
  @@map("cotacoes_avulsas")
}

model Cotacao {
  id             String   @id @default(uuid())
  itemWishlistId String   @map("item_wishlist_id")
  lojaId         String?  @map("loja_id")
  preco          Decimal  @db.Decimal(10, 2)
  url            String?  @db.Text
  observacoes    String?  @db.Text
  dataCotacao    DateTime @default(now()) @map("data_cotacao")

  itemWishlist ItemWishlist @relation(fields: [itemWishlistId], references: [id], onDelete: Cascade)
  loja         Loja?        @relation(fields: [lojaId], references: [id])

  @@map("cotacoes")
}

model Projeto {
  id                 String        @id @default(uuid())
  workspaceId        String        @map("workspace_id")
  nome               String
  descricao          String?
  icone              String?
  cor                String?
  orcamentoEstimado  Decimal?      @map("orcamento_estimado") @db.Decimal(12, 2)
  prazoEstimado      String?       @map("prazo_estimado")
  status             StatusProjeto @default(PLANEJAMENTO)
  prioridade         Int           @default(1)
  dataInicioPrevista DateTime?     @map("data_inicio_prevista")
  dataFimPrevista    DateTime?     @map("data_fim_prevista")
  dataConclusao      DateTime?     @map("data_conclusao")
  versao             Int           @default(0)
  ativo              Boolean       @default(true)
  dataCriacao        DateTime      @default(now()) @map("data_criacao")
  dataAtualizacao    DateTime      @updatedAt @map("data_atualizacao")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  etapas    EtapaProjeto[]

  @@index([workspaceId, status, ativo])
  @@map("projetos")
}

model EtapaProjeto {
  id              String      @id @default(uuid())
  workspaceId     String      @map("workspace_id")
  projetoId       String      @map("projeto_id")
  nome            String
  descricao       String?
  ordem           Int         @default(1)
  status          StatusEtapa @default(PENDENTE)
  dataInicio      DateTime?   @map("data_inicio")
  dataConclusao   DateTime?   @map("data_conclusao")
  versao          Int         @default(0)
  ativo           Boolean     @default(true)
  dataCriacao     DateTime    @default(now()) @map("data_criacao")
  dataAtualizacao DateTime    @updatedAt @map("data_atualizacao")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projeto   Projeto       @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  itens     ItemProjeto[]

  @@index([workspaceId, projetoId, ativo])
  @@map("etapas_projeto")
}

model ItemProjeto {
  id                      String   @id @default(uuid())
  workspaceId             String   @map("workspace_id")
  etapaId                 String   @map("etapa_id")
  itemWishlistId          String?  @map("item_wishlist_id")
  metaId                  String?  @map("meta_id")
  wishlistVinculoAtivoKey String?  @unique @map("wishlist_vinculo_ativo_key")
  metaVinculoAtivoKey     String?  @unique @map("meta_vinculo_ativo_key")
  observacoes             String?
  versao                  Int      @default(0)
  ativo                   Boolean  @default(true)
  dataCriacao             DateTime @default(now()) @map("data_criacao")
  dataAtualizacao         DateTime @updatedAt @map("data_atualizacao")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  etapa        EtapaProjeto  @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  itemWishlist ItemWishlist? @relation(fields: [itemWishlistId], references: [id], onDelete: Restrict)
  meta         Meta?         @relation(fields: [metaId], references: [id], onDelete: Restrict)

  @@index([workspaceId, etapaId, ativo])
  @@index([workspaceId, itemWishlistId, ativo])
  @@index([workspaceId, metaId, ativo])
  @@map("itens_projeto")
}

// ------------------------------------------------------
// PLANEJAMENTO E SISTEMA
// ------------------------------------------------------

model Orcamento {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  categoriaId     String   @map("categoria_id")
  mes             Int
  ano             Int
  valorPlanejado  Decimal  @map("valor_planejado") @db.Decimal(12, 2)
  valorReal       Decimal  @default(0) @map("valor_real") @db.Decimal(12, 2)
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, mes, ano, categoriaId])
  @@map("orcamentos")
}

model Projecao {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  mes         Int
  ano         Int
  tipo        String
  tipoOrigem  String?  @map("tipo_origem")
  origemId    String?  @map("origem_id")
  valor       Decimal  @db.Decimal(12, 2)
  descricao   String
  recorrente  Boolean  @default(false)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("projecoes")
}

model Feriado {
  id         String      @id @default(uuid())
  data       DateTime
  nome       String
  tipo       TipoFeriado @default(NACIONAL)
  estado     String?
  recorrente Boolean     @default(true)

  @@map("feriados")
}

model ConfigMes {
  id           String  @id @default(uuid())
  workspaceId  String  @map("workspace_id")
  mes          Int
  ano          Int
  totalDias    Int     @map("total_dias")
  diasUteis    Int     @map("dias_uteis")
  finaisSemana Int     @map("finais_semana")
  feriados     Int
  observacoes  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, mes, ano])
  @@map("config_meses")
}

model Alerta {
  id                String     @id @default(uuid())
  usuarioId         String     @map("usuario_id")
  workspaceId       String?    @map("workspace_id")
  tipo              TipoAlerta
  titulo            String
  mensagem          String
  tipoReferencia    String?    @map("tipo_referencia")
  referenciaId      String?    @map("referencia_id")
  chaveIdempotencia String?    @unique @map("chave_idempotencia")
  lido              Boolean    @default(false)
  dataLeitura       DateTime?  @map("data_leitura")
  dataDisparo       DateTime   @default(now()) @map("data_disparo")

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lido])
  @@index([workspaceId, lido])
  @@map("alertas")
}

model ConfigAlerta {
  id        String     @id @default(uuid())
  usuarioId String     @map("usuario_id")
  tipo      TipoAlerta
  ativo     Boolean    @default(true)
  limite    Decimal?   @db.Decimal(12, 2)
  config    Json?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("config_alertas")
}
